+    assert len(failed) == 6, f"重复失败命令应产出 6 条，实际 {len(failed)}"
+    for r in failed:
+        assert r.exit_signal != "pending", "status=failed 的已结束命令被误判 pending"
+        assert r.exit == 2
+        assert r.ts_end is not None
+        assert r.output_hash is not None
