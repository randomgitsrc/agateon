AGATE_HOME="${AGATE_HOME:-$HOME/.agate}"
while [ "${AGATE_HOME%/}" != "$AGATE_HOME" ]; do AGATE_HOME="${AGATE_HOME%/}"; done
[ ! -L "$AGATE_HOME" ] || { echo "AGATE_HOME 是软链，请先按迁移三步处理"; false; }
