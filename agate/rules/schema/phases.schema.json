{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agate/rules/phases.yaml schema (draft-07 subset)",
  "type": "object",
  "required": ["schema_version", "phases"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "exec_role", "gate_pass_exit"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P6.5", "P7", "P8"]
          },
          "name": {
            "type": "string"
          },
          "exec_role": {
            "type": "string",
            "enum": [
              "analyst", "architect", "test-designer", "implementer",
              "verifier", "consistency-reviewer", "judge", "releaser", "main-agent"
            ]
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file"],
              "properties": {
                "file": {"type": "string"},
                "required": {"type": "boolean"},
                "status_field": {"type": "string"}
              }
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["check"],
              "properties": {
                "check": {"type": "string"}
              }
            }
          },
          "retry_cap": {
            "type": "integer",
            "enum": [2, 3]
          },
          "task_fields": {
            "type": "array",
            "items": {"type": "string"}
          },
          "next": {
            "type": ["string", "null"],
            "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", null]
          },
          "retreat": {
            "type": ["string", "null"],
            "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", null]
          },
          "gate_subphase": {
            "type": "object",
            "required": ["hosted_on", "forward_to", "needs_revision_to"],
            "properties": {
              "hosted_on": {
                "type": "string",
                "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8"]
              },
              "forward_to": {
                "type": "string",
                "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8"]
              },
              "needs_revision_to": {
                "type": "string",
                "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8"]
              }
            },
            "additionalProperties": false
          },
          "gate_pass_exit": {
            "type": "integer",
            "enum": [0, 2]
          }
        },
        "additionalProperties": false
      }
    },
    "non_prunable_phases": {
      "type": "array",
      "items": {"type": "string"},
      "description": "不可跳过/不可裁剪阶段集（RM-AG0110 判据单源；check-pruning 与 check-state-transition 共读）"
    },
    "gate_layer": {
      "type": "object",
      "required": ["commit_types", "transitions"],
      "properties": {
        "commit_types": {
          "type": "object",
          "properties": {
            "code-only": {
              "type": "array",
              "items": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P6.5", "P7", "P8"]}
            },
            "docs-only": {
              "type": "array",
              "items": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P6.5", "P7", "P8"]}
            },
            "release": {
              "type": "array",
              "items": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P6.5", "P7", "P8"]}
            }
          },
          "additionalProperties": false
        },
        "transitions": {
          "type": "object",
          "properties": {
            "forward": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to"],
                "properties": {
                  "from": {"type": "string"},
                  "to": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "retreat": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to"],
                "properties": {
                  "from": {"type": "string"},
                  "to": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "pause": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["to", "paused_from"],
                "properties": {
                  "to": {"type": "string"},
                  "paused_from": {
                    "type": "array",
                    "items": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P6.5", "P7", "P8"]}
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
