# gate result（每 commit 由 pre-commit hook 重新生成）
.gate-result.json

# gate 历史（运行时追加，不是仓库内容）
.gate-history.jsonl

# OpenCode 项目级接入层（软链 → docs/converse/agents，本地环境配置不入库）
.opencode/

# Claude Code 项目级接入层（软链 → docs/converse/agents，本地环境配置不入库）
.claude/

# Python
__pycache__/
*.pyc

# pytest / ruff 缓存（显式声明，不依赖工具自生成 .gitignore）
.pytest_cache/
.ruff_cache/

# 编辑器临时文件
*.swp
*.swo
*.bak
*~
.DS_Store
.worktrees/

# Agateon canonical 临时产物目录（探针 / 一次性脚本 / 抓取物；协议自应用，见
# agate/platform-notes.md「受限 harness 通用约束」。本仓此前未忽略它——协议定义者
# 自己不遵守，会让该约定看起来像「无消费方的声明」）
.agate-tmp/

# 发布产物（dist/ 忽略；version.txt 是发布版本文件，必须入库，不被任何规则误忽略）
dist/
!version.txt

# pytest 测试残留（个别用例在仓库根建的临时目录）
.pytest-tmp/

# VitePress 站点（site/）：依赖 / 构建产物 / public 品牌快照（由 sync-brand.mjs 生成）
site/node_modules/
site/.vitepress/dist/
site/.vitepress/cache/
site/public/
